{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "pretty-errors": ["common/pretty-errors/src/index"],
      "trace-commands": ["common/trace-commands/src/index"],
      "gh-inputs": ["common/gh-inputs/src/index"],
      "action-schema": ["common/action-schema/src/index"],
      "setup-program": ["setup-program/src/index"],
      "setup-gcc": ["setup-gcc/src/index"],
      "setup-clang": ["setup-clang/src/index"],
      "setup-msvc": ["setup-msvc/src/index"],
      "setup-cmake": ["setup-cmake/src/index"]
    }
  },
  "include": [
    "*/src/**/*.ts",
    "common/*/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "*/node_modules",
    "*/dist",
    "*/lib",
    "docs"
  ]
}
