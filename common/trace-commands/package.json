{
  "name": "trace-commands",
  "version": "1.9.1",
  "description": "Conditional command tracing for GitHub Actions",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc -p .config/tsconfig.json",
    "prepare": "npm run build && node ../../utils/esbuild/dist/index.js .",
    "typecheck": "tsc -p .config/tsconfig.json --noEmit",
    "test": "jest --config ../../jest.config.js --selectProjects trace-commands",
    "all": "npm run prepare && npm run test"
  },
  "keywords": [],
  "author": "",
  "license": "Boost Software License 1.0",
  "dependencies": {
    "@actions/core": "^2.0.1",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "esbuild": "^0.27.2"
  }
}
