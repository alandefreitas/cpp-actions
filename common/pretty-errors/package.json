{
  "name": "pretty-errors",
  "version": "1.9.2",
  "description": "Small helper to render source-mapped, pretty-formatted errors for GitHub Actions",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc -p .config/tsconfig.json",
    "prepare": "npm run build && node ../../utils/esbuild/dist/index.js .",
    "typecheck": "tsc -p .config/tsconfig.json --noEmit",
    "test": "jest --config ../../jest.config.js --selectProjects pretty-errors",
    "example": "tsc -p .config/tsconfig.json && node lib/example.js",
    "all": "npm run prepare && npm run test"
  },
  "keywords": [],
  "author": "",
  "license": "Boost Software License 1.0",
  "dependencies": {
    "@actions/core": "^2.0.1",
    "source-map": "^0.7.6",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "esbuild": "^0.27.2"
  }
}
