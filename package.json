{
  "name": "cpp-actions-monorepo",
  "version": "1.9.0",
  "private": true,
  "description": "GitHub Actions for C++ projects",
  "workspaces": [
    "common/gh-inputs",
    "common/pretty-errors",
    "common/trace-commands",
    "utils/esbuild",
    "utils/jsdoc-linter",
    "utils/build",
    "utils/release",
    "b2-workflow",
    "boost-clone",
    "cmake-workflow",
    "cpp-matrix",
    "create-changelog",
    "flamegraph",
    "package-install",
    "setup-clang",
    "setup-cmake",
    "setup-cpp",
    "setup-gcc",
    "setup-msvc",
    "setup-program"
  ],
  "scripts": {
    "build": "node utils/build/dist/index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepare": "npm run prepare --workspaces --if-present",
    "lint:jsdoc": "node utils/jsdoc-linter/dist/index.js",
    "depcheck": "npm exec --workspaces -- depcheck",
    "update-deps": "npm exec --workspaces -- npm-check-updates -u && npm install",
    "version:set": "npm version --workspaces --include-workspace-root --no-git-tag-version --allow-same-version",
    "docs": "node utils/build/dist/index.js --docs",
    "release": "node utils/release/dist/index.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0"
  }
}
